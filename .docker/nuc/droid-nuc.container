# Quadlet container unit for the DROID NUC control server (Franka Panda).
# Install (rootful): copy together with droid-nuc.build into
# /etc/containers/systemd/, adjust the Volume= host path to the NUC's droid
# checkout, then:
#   systemctl daemon-reload && systemctl enable --now droid-nuc
#
# Mirrors docker-compose-nuc.yaml: host networking (zerorpc :4242, polymetis
# gRPC :50051, libfranka out to the robot), SCHED_FIFO + mlockall for the
# 1kHz control loop, and /dev/cpu_dma_latency to pin CPU C-states.

[Unit]
Description=DROID Franka Panda control server
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=droid-nuc
Image=droid-nuc.build
Network=host
# rootless-style isolation; SCHED_FIFO still works because RLIMIT_RTPRIO
# authorizes it without CAP_SYS_NICE in the initial namespace, and podman
# creates the device node owned by the mapped container root.
# Requires a "containers" range in /etc/subuid and /etc/subgid.
UserNS=auto
AddCapability=SYS_NICE
AddDevice=/dev/cpu_dma_latency
Ulimit=rtprio=99
Ulimit=memlock=-1:-1
# machine-specific runtime parameters (sudo password etc.); :Z relabels for
# SELinux-enforcing hosts (e.g. MicroOS), no-op elsewhere
Volume=/home/robot/droid/droid/misc/parameters.py:/app/droid/misc/parameters.py:ro,Z
# machine IPs: ROBOT_IP/NUC_IP/LAPTOP_IP override the parameters.py defaults;
# set them here (ansible templates these lines) the same way the droid-robot
# and droid-gripper units set ROBOT_IP for the launch wrappers
# Environment=ROBOT_IP=172.16.0.4
# Environment=NUC_IP=172.16.0.2
StopTimeout=10

[Service]
Restart=always
# must exceed StopTimeout so systemd doesn't kill podman mid-stop
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
